' Common

Private Sub Worksheet_Change(ByVal Target As Range)
    Dim rng As Range
    Set rng = Target
    If Not Intersect(rng, Me.Range("V:V")) Is Nothing Then
        If IsNumeric(Left(rng.Value, 2)) And InStr(rng.Value, "-") > 0 Then
            Dim parts() As String
            parts = Split(rng.Value, "-")
            rng.Value = DateSerial(2000 + CInt(parts(0)), CInt(parts(1)), 1)
            rng.NumberFormat = "yyyy.mm"
        End If
    End If
End Sub


' 시트 생성 / 초기화
Public Function CreateOrClearSheet(name As String) As Worksheet
    Dim wsSrc As Worksheet
    Set wsSrc = ActiveSheet
    
    On Error Resume Next
    Set CreateOrClearSheet = Worksheets(name)
    On Error GoTo 0
    
    If CreateOrClearSheet Is Nothing Then
        Set CreateOrClearSheet = Worksheets.Add(After:=wsSrc)
        CreateOrClearSheet.name = name
    Else
        CreateOrClearSheet.Cells.Clear
    End If
End Function
' 헤더 작성
Public Sub WriteHeaders(ws As Worksheet, headers As Variant)
    Dim i As Integer
    For i = 0 To UBound(headers)
        ws.Cells(1, i + 1).Value = headers(i)
    Next i
End Sub
' 전화번호 포맷
Public Function FormatPhone(phone As String) As String
    Dim nums As String, i As Integer
    For i = 1 To Len(phone)
        If Mid(phone, i, 1) Like "#" Then
            nums = nums & Mid(phone, i, 1)
        End If
    Next i
    
    If Len(nums) = 11 Then
        FormatPhone = Left(nums, 3) & "-" & Mid(nums, 4, 4) & "-" & Right(nums, 4)
    ElseIf Len(nums) = 10 Then
        FormatPhone = Left(nums, 3) & "-" & Mid(nums, 4, 3) & "-" & Right(nums, 4)
    Else
        FormatPhone = nums
    End If
End Function

' 우편번호 포맷
Public Function FormatZip(zipCode As Variant) As String
    If IsError(zipCode) Or Trim(zipCode & "") = "" Then
        FormatZip = ""
    Else
        FormatZip = Format(Val(zipCode), "00000")
    End If
End Function

' 시트 저장
Public Sub SaveAsExcel(ws As Worksheet, FileName As String)
    Dim tempWB As Workbook
    ws.Copy
    Set tempWB = ActiveWorkbook
    
    Dim basePath As String
    basePath = CreateObject("WScript.Shell").SpecialFolders("Desktop") & "\"
    
    Dim dateStr As String
    dateStr = Format(Now, "yyyymmdd_hhnn")
    
    Dim fullName As String, path As String, n As Integer: n = 1
    fullName = dateStr & "_" & FileName & ".xls"
    path = basePath & fullName
    
    Do While Dir(path) <> ""
        fullName = dateStr & "_" & FileName & "_" & n & "차.xls"
        path = basePath & fullName
        n = n + 1
    Loop
    
    Application.DisplayAlerts = False
    tempWB.SaveAs FileName:=path, FileFormat:=xlExcel8
    'tempWB.Close False
    Application.DisplayAlerts = True
End Sub
